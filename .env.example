# 복사해서 .env 로 저장하세요.  (.env 는 git에 올라가지 않습니다)
# ── 기본 설정 ──────────────────────────────
SECRET_KEY=change-me             # Flask 세션 암호화 비밀키 (미설정 시 기본값 dev-secret 사용)
PORT=5000

# ── AWS 자격 증명 (boto3 표준 변수명) ──────────
# 로컬 개발 시 AWS IAM 사용자의 자격 증명을 입력하세요.
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_REGION=ap-northeast-2

# ── 6주차 · S3 ──────────────────────────────
# STORAGE_BACKEND=local          # local | s3
# S3_BUCKET=tube-lite-teamN      # S3 버킷 이름 (예: tube-lite-team5)

# ── 7주차 · DynamoDB ────────────────────────
# DB_BACKEND=sqlite              # sqlite | dynamodb
# DDB_PREFIX=tube-lite-teamN-    # 테이블 이름 접두사 (예: tube-lite-team5-)

# ── 9주차 · Lambda + SNS ────────────────────
# NOTIFY_BACKEND=local           # local | sns
# SNS_TOPIC_ARN=arn:aws:sns:ap-northeast-2:...
